# Staging environment variables
# Copy to .env.staging and fill in values

# Database password for the staging Postgres container
STAGING_DB_PASSWORD=""

# Root admin email (auto-promoted to admin on login)
ROOT_ADMIN_EMAIL=""

# Better Auth — must be different from production!
# Generate: openssl rand -hex 16
BETTER_AUTH_SECRET=""

# osu! OAuth — separate app from production
# Register at https://osu.ppy.sh/home/account/edit
# Callback URL: https://staging.esports.vash.software/api/auth/oauth2/callback/osu
OSU_CLIENT_ID=""
OSU_CLIENT_SECRET=""

# osu! IRC — separate account from production to avoid conflicts
# Get credentials at https://osu.ppy.sh/p/irc
OSU_IRC_USERNAME=""
OSU_IRC_PASSWORD=""

# Discord — optional, use a staging channel or leave blank to disable
DISCORD_BOT_TOKEN=""
DISCORD_MATCH_CHANNEL_ID=""

# Cloudflare R2 — can share with production (read-only image cache)
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET="vash-esports-images"
R2_PUBLIC_URL="https://cdn.esports.vash.software"
