R2_SECRET_ACCESS_KEY=""    # R2 API token Secret Access Key
R2_BUCKET=""               # Bucket name, e.g. vash-esports-images
R2_PUBLIC_URL=""           # Public URL for the bucket, e.g. https://cdn.esports.vash.software
